# Copy to aws/.env (git-ignored). `node aws/gen-env.mjs` writes the first block; fill in the rest.
# The same file goes to the server at ~/huddle/aws/.env. Never commit real values.

# --- generated by aws/gen-env.mjs ---
PG_PASSWORD=
AUTHENTICATOR_PASSWORD=
JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_SITE_URL=https://xxxx.cloudfront.net

# --- models ---
AI_PROVIDER=bedrock               # or gemini (then GEMINI_API_KEY is the only model key needed), or openai (below)
# AI_PROVIDER=openai: any OpenAI-compatible model: Ollama (local or cloud models), OpenRouter, vLLM, LM Studio, OpenAI…
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1    # Ollama on this server; or https://openrouter.ai/api/v1
# OPENAI_API_KEY=                                         # not needed for Ollama
# OPENAI_MODEL=glm-5.3:cloud                              # everyday: brief, intake, reviews, plans
# OPENAI_SMART_MODEL=                                     # free-text work (research, prototypes); defaults to OPENAI_MODEL
# OPENAI_VISION_MODEL=gemma4:31b-cloud                    # photos and sketches; defaults to OPENAI_MODEL
# With a GEMINI_API_KEY too, audio, video and PDFs still go to Gemini; SEARCH_PROVIDER=gemini also sends web research there.
# Without one, research runs without live web search (marked unsourced) and speech uses the browser.
AWS_REGION=us-west-2
# Bedrock auth, one of:
AWS_BEARER_TOKEN_BEDROCK=         #   a Bedrock API key (long-lived; best for a box that outlives a session)
AWS_ACCESS_KEY_ID=                #   or IAM credentials; session credentials expire with the session
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
GEMINI_API_KEY=                   # optional on Bedrock: voice notes and audio uploads
# Optional model overrides: BEDROCK_FAST_MODEL, BEDROCK_SMART_MODEL, BEDROCK_MEDIA_MODEL, BEDROCK_SEARCH_MODEL, BEDROCK_REGION

# --- sponsors ---
ANCHOR_API_KEY=                   # web research page reads + smoke tests
DAYTONA_API_KEY=                  # sandboxes: hosting, checks, operator verify, secret scan
SANDBOX_IDLE_MINUTES=15           # Daytona auto-stop; stopped sandboxes keep their files
ARIZE_API_KEY=
ARIZE_SPACE_ID=
ARIZE_PROJECT=huddle
ARIZE_PROJECT_ID=                 # `ax projects list`
ARIZE_PROJECT_URL=                # the link job cards open
EVAL_TOKEN=                       # random string shared with CI (secret EVAL_TOKEN); guards eval-run

# --- GitHub (rooms backed by repos, sign-in, operator) ---
GITHUB_CLIENT_ID=                 # OAuth App; callback https://<site>/auth/callback
GITHUB_CLIENT_SECRET=
GITHUB_ORG=Huddle-public-repos    # public rooms publish here
GITHUB_ORG_TOKEN=                 # fine-grained token: that org's repos, contents + administration + pages
GITHUB_TEMPLATE=Huddle-public-repos/huddle-room-template
ADMIN_LOGINS=kishorebhatia        # who gets the operator room
SELF_REPO=kishorebhatia/huddle-ai-collab
SELF_BRANCH=redesign-v4
OPERATOR_ROOM=huddle-operator
