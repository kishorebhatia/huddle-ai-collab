# Copy to .env (git-ignored). Used by scripts/write-config.mjs to generate web/config.js.
# On Vercel, set the same two names as project environment variables instead.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (or legacy anon) key — meant for browsers, protected by RLS
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional, only for CLI deploys from your machine (never commit real values):
# SUPABASE_ACCESS_TOKEN=sbp_xxx
# VERCEL_TOKEN=xxx
