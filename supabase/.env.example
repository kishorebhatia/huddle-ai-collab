# Copy to supabase/.env (git-ignored), then: npx supabase secrets set --env-file supabase/.env
GEMINI_API_KEY=your-gemini-api-key

# Optional model overrides (defaults were tested Oct 2026)
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_SMART_MODEL=gemini-3.8-flash
# TRANSCRIBE_MODEL=gemini-3.5-transcribe
# TRANSCRIBE_FALLBACK_MODEL=gemini-3.5-flash-lite
# SYNTH_THINKING=low
# PROTOTYPE_THINKING=low
