# Copy to supabase/.env (git-ignored), then: npx supabase secrets set --env-file supabase/.env
GEMINI_API_KEY=your-gemini-api-key
# Where published prototypes are served (your deployed web app)
PUBLIC_SITE_URL=https://your-huddle.vercel.app

# Optional: deploy each published prototype as its own Vercel project instead
# HOST_MODE=vercel
# VERCEL_TOKEN=xxx
# VERCEL_TEAM_ID=team_xxx

# Optional model overrides (defaults were tested Oct 2026)
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_SMART_MODEL=gemini-3.8-flash
# TRANSCRIBE_MODEL=gemini-3.5-transcribe
# TRANSCRIBE_FALLBACK_MODEL=gemini-3.5-flash-lite
# SYNTH_THINKING=low
# PROTOTYPE_THINKING=low
